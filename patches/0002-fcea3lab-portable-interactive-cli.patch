     call parse_arguments(input_file_stem, thermo_file, trans_file, compile_thermo_input, compile_trans_input)
     call log_info('CEA Version: '//version_string)
 
@@ -64,16 +73,35 @@ program cea
 
     call get_data_search_dirs(data_search_dirs)
 
+    ! FCEA3LAB: search the executable's directory (and its data/ subdirectory)
+    ! right after the working directory and CEA_DATA_DIR
+    exe_dir = get_exe_dir()
+    if (len(exe_dir) > 0) then
+        call get_environment_variable("CEA_DATA_DIR", length=env_len, status=env_status)
+        k = 1
+        if (env_status == 0 .and. env_len > 0) k = 2
+        ml = max(len(data_search_dirs), len(exe_dir) + 5)
+        allocate(character(ml) :: dirs_tmp(size(data_search_dirs) + 2))
+        dirs_tmp(1:k) = data_search_dirs(1:k)
+        dirs_tmp(k+1) = exe_dir
+        dirs_tmp(k+2) = exe_dir//'/data'
+        dirs_tmp(k+3:) = data_search_dirs(k+1:)
+        call move_alloc(dirs_tmp, data_search_dirs)
+    end if
+
     thermo_file = locate(thermo_file, data_search_dirs)
     if (len(thermo_file) == 0) then
         call abort('Could not locate thermo file: '//thermo_file)
     end if
+    write(stdout, '(a)') ' thermo database:    '//thermo_file
 
