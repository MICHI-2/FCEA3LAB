     end subroutine
 
+    subroutine read_input_name_interactive(input_file_stem)
+        ! Prompt for the case name like FCEA2, so that `echo name | FCEA3LAB` works.
+        character(:), allocatable, intent(out) :: input_file_stem
+        character(len=1024) :: line
+        integer :: ios, l
+
+        write(stdout, '(a)') ' ENTER INPUT FILE NAME WITHOUT .inp EXTENSION.'
+        write(stdout, '(a)') '   THE OUTPUT FILE WILL HAVE THE SAME NAME WITH EXTENSION .out'
+        write(stdout, '(a)') '   (.plt PLOT FILES ARE NOT PRODUCED BY THIS VERSION)'
+        write(stdout, '(a)') ''
+        read(stdin, '(a)', iostat=ios) line
+        if (ios /= 0) then
+            call log_error('No input file name was entered')
+            call abort
+        end if
+        line = adjustl(line)
+        l = len_trim(line)
+        if (l == 0) then
+            call log_error('No input file name was entered')
+            call abort
+        end if
+        input_file_stem = line(1:l)
+        if (l > 4) then
+            if (line(l-3:l) == '.inp') input_file_stem = line(1:l-4)
+        end if
+    end subroutine
+
     subroutine write_problem_input(ioout, prob, separate_from_previous)
         integer, intent(in) :: ioout
         type(ProblemDB), intent(in) :: prob
