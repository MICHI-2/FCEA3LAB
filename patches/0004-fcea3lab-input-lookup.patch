@@ -70,6 +72,25 @@ program cea
     call log_info('Thermo File: '//thermo_file)
 
     if (.not. exists(input_file_stem//'.inp')) then
+        ! FCEA3LAB: a double-clicked program does not start in its own folder
+        ! on macOS/Linux (the terminal opens in the home folder), so also look
+        ! next to the executable before giving up.
+        exe_dir = get_exe_dir()
+        if (len(exe_dir) > 0) then
+            if (exists(exe_dir//'/'//input_file_stem//'.inp')) then
+                input_file_stem = exe_dir//'/'//input_file_stem
+                write(stdout, '(a)') ' input file:         '//input_file_stem//'.inp'
+            else if (exists(exe_dir//'/samples/'//input_file_stem//'.inp')) then
+                input_file_stem = exe_dir//'/samples/'//input_file_stem
+                write(stdout, '(a)') ' input file:         '//input_file_stem//'.inp'
+            end if
+        end if
+    end if
+    if (.not. exists(input_file_stem//'.inp')) then
+        write(stdout, '(a)') ' Could not find '//input_file_stem//'.inp'
+        write(stdout, '(a)') '   looked in the working folder: '//get_cwd()
+        if (len(get_exe_dir()) > 0) write(stdout, '(a)') '   and next to the program:      '//get_exe_dir()//' (and its samples)'
+        write(stdout, '(a)') '   Start the program in the folder of the .inp file, or type (or drag in) the full path.'
         call abort('Could not locate input file: '//input_file_stem)
     end if
 
