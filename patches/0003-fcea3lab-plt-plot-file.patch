+                            call rocket_plot_perf(pt%perf, prob, solutions(i, j, keq), idx)
+                    else
+                        call rocket_plot_perf(pt%perf, prob, solutions(i, j, kfr), idx)
+                    end if
+                    if (kfr > 0) call rocket_plot_perf(pt%perf_fr, prob, solutions(i, j, kfr), idx)
+                    call plot_add(pt)
+                end do
+            end do
+        end do
+    end subroutine
+
+    integer function rocket_plot_npts(prob, s) result(np)
+        ! Stations actually solved (rocket_output has already removed the
+        ! "infinity" station of finite-area-combustor problems from the arrays).
+        type(ProblemDB), intent(in) :: prob
+        type(RocketSolution), intent(in) :: s
+        integer :: last
+        np = s%num_pts
+        last = s%last_completed_idx
+        if (last > 0) then
+            if (prob%problem%rkt_finite_area) last = last - 1
+            np = min(np, last)
+        end if
+    end function
+
+    subroutine rocket_plot_perf(perf, prob, s, idx)
+        ! pi/p (Pinf/P, or Pinj/P for fac), mach, ae/at, cf, ivac, isp
+        real(dp), intent(out) :: perf(6)
+        type(ProblemDB), intent(in) :: prob
+        type(RocketSolution), intent(in) :: s
+        integer, intent(in) :: idx
+        real(dp) :: g
+        perf = 0.0d0
+        if (s%eq_soln(idx)%pressure > 0.0d0) perf(1) = s%eq_soln(1)%pressure/s%eq_soln(idx)%pressure
+        perf(2) = s%mach(idx)
+        if (idx == 1) return    ! chamber (injector): CEA2 writes 0 for ae, cf, ivac, isp
+        g = 1.0d0
+        if (.not. prob%output%siunit) g = std_gravity
+        perf(3) = s%ae_at(idx)
+        perf(4) = s%cf(idx)
+        perf(5) = s%i_vac(idx)/g
+        perf(6) = s%i_sp(idx)/g
+    end subroutine
+
+    subroutine plot_deton(prob, solver, solutions)
+        ! o/f outer; then the same order as the columns of the .out file
+        type(ProblemDB), intent(in) :: prob
+        type(DetonSolver), intent(in) :: solver
+        type(DetonSolution), intent(in) :: solutions(:, :, :)
+        type(plot_point) :: pt
+        integer :: i, j, k
+        do k = 1, size(solutions, 3)
+            do i = 1, size(solutions, 1)
+                do j = 1, size(solutions, 2)
+                    pt = plot_point()
+                    pt%det = .true.
+                    call plot_fill_eq(pt, prob, solutions(i, j, k)%eq_soln, solutions(i, j, k)%eq_partials, &
+                                      solver%eq_solver%products%species_names)
+                    call plot_fill_ratios(pt, prob, solver%eq_solver%reactants, k)
+                    pt%son = solutions(i, j, k)%sonic_velocity
+                    pt%vel = solutions(i, j, k)%velocity
+                    pt%detmach = solutions(i, j, k)%mach
+                    pt%t1 = solutions(i, j, k)%T1
+                    pt%gam1 = solutions(i, j, k)%gamma1
+                    pt%son1 = solutions(i, j, k)%v_sonic1
+                    if (prob%output%siunit) then
+                        pt%p = solutions(i, j, k)%pressure
+                        pt%p1 = solutions(i, j, k)%P1
+                        pt%h1 = solutions(i, j, k)%H1
+                    else
+                        pt%p = solutions(i, j, k)%pressure/1.01325d0
+                        pt%p1 = solutions(i, j, k)%P1/1.01325d0
+                        pt%h1 = joules_to_cal(solutions(i, j, k)%H1)
+                    end if
+                    call plot_add(pt)
+                end do
+            end do
+        end do
+    end subroutine
