+    !-------------------------------------------------------------------
+    ! FCEA3LAB: collect .plt rows (point order follows CEA2)
+    !-------------------------------------------------------------------
+
+    subroutine plot_fill_eq(pt, prob, s, part, names)
+        ! Thermodynamic and transport values of one equilibrium state, in the
+        ! units printed in the .out file (SI or calorie units).
+        ! CEA2 convention: "mw" -> M = 1/n, "m" -> MW (includes condensed species).
+        type(plot_point), intent(inout) :: pt
+        type(ProblemDB), intent(in) :: prob
+        type(EqSolution), intent(in) :: s
+        type(EqPartials), intent(in) :: part
+        character(*), intent(in) :: names(:)
+        logical :: si
+
+        si = prob%output%siunit
+        if (si) then
+            pt%p = s%pressure
+            pt%rho = s%density
+            pt%h = s%enthalpy
+            pt%u = s%energy
+            pt%g = s%gibbs_energy
+            pt%s = s%entropy
+            pt%cp = s%cp_eq
+            pt%cond = s%conductivity_eq
+            pt%cond_fr = s%conductivity_fr
+        else
+            pt%p = s%pressure/1.01325d0
+            pt%rho = s%density/1.d3
+            pt%h = joules_to_cal(s%enthalpy)
+            pt%u = joules_to_cal(s%energy)
+            pt%g = joules_to_cal(s%gibbs_energy)
+            pt%s = joules_to_cal(s%entropy)
+            pt%cp = joules_to_cal(s%cp_eq)
+            pt%cond = joules_to_cal(s%conductivity_eq)
+            pt%cond_fr = joules_to_cal(s%conductivity_fr)
+        end if
+        pt%t = s%T
+        pt%mw = 1.0d0/s%n
+        pt%m = s%MW
+        if (pt%m <= 0.0d0) pt%m = pt%mw
+        pt%gam = part%gamma_s
+        pt%dlnt = part%dlnV_dlnT
+        pt%dlnp = part%dlnV_dlnP
+        pt%vis = s%viscosity
+        pt%pran = s%Pr_eq
+        pt%pran_fr = s%Pr_fr
+        allocate(pt%species(size(names)), pt%x(size(names)))
+        pt%species = names
+        pt%x = 0.0d0
+        if (prob%output%mass_fractions) then
+            if (allocated(s%mass_fractions)) pt%x(1:size(s%mass_fractions)) = s%mass_fractions
+        else
+            if (allocated(s%mole_fractions)) pt%x(1:size(s%mole_fractions)) = s%mole_fractions
+        end if
+    end subroutine
+
+    subroutine plot_fill_ratios(pt, prob, reactants, k)
+        type(plot_point), intent(inout) :: pt
+        type(ProblemDB), intent(in) :: prob
+        type(Mixture), intent(in) :: reactants
+        integer, intent(in) :: k
+        real(dp) :: of_ratio, pct_fuel, r_eq, phi_eq
+        call compute_fuel_ratios(prob, reactants, k, of_ratio, pct_fuel, r_eq, phi_eq)
+        pt%of = of_ratio
+        pt%pf = pct_fuel
+        pt%req = r_eq
+        pt%phi = phi_eq
+        pt%fa = 0.0d0
+        if (of_ratio /= 0.0d0) pt%fa = 1.0d0/of_ratio
+    end subroutine
+
+    subroutine plot_thermo(prob, solver, solutions, partials)
+        ! tp/hp/sp/tv/uv/sv: o/f outer, second state variable, first state variable inner
+        type(ProblemDB), intent(in) :: prob
+        type(EqSolver), intent(in) :: solver
+        type(EqSolution), intent(in) :: solutions(:, :, :)
+        type(EqPartials), intent(in) :: partials(:, :, :)
+        type(plot_point) :: pt
+        integer :: i, j, k
+        do k = 1, size(solutions, 3)
+            do j = 1, size(solutions, 2)
+                do i = 1, size(solutions, 1)
+                    pt = plot_point()
+                    call plot_fill_eq(pt, prob, solutions(i, j, k), partials(i, j, k), solver%products%species_names)
+                    pt%son = sqrt(solutions(i, j, k)%n*R*partials(i, j, k)%gamma_s*solutions(i, j, k)%T)
+                    call plot_fill_ratios(pt, prob, solver%reactants, k)
+                    call plot_add(pt)
+                end do
+            end do
+        end do
+    end subroutine
+
+    subroutine plot_rocket(prob, solver, solutions)
+        ! One row per station; o/f outer, chamber pressure inner (CEA2 order).
+        ! As in CEA2, when both equilibrium and frozen are solved the
+        ! thermodynamic columns hold the frozen values, the unsuffixed rocket
+        ! columns (isp, cf, ...) the equilibrium values, and the "fz"/"fr"
+        ! columns the frozen values.
+        type(ProblemDB), intent(in) :: prob
+        type(RocketSolver), intent(in) :: solver
+        type(RocketSolution), intent(in) :: solutions(:, :, :)
+        type(plot_point) :: pt
+        integer :: i, j, idx, np, keq, kfr, kth
+
+        keq = 0
+        kfr = 0
+        if (size(solutions, 3) >= 2) then
+            keq = 1
+            kfr = 2
+        else if (prob%problem%frozen .and. .not. prob%problem%equilibrium) then
+            kfr = 1
+        else
+            keq = 1
+        end if
+        kth = keq
+        if (kfr > 0) kth = kfr
+
+        do j = 1, size(solutions, 2)
+            do i = 1, size(solutions, 1)
+                np = rocket_plot_npts(prob, solutions(i, j, kth))
+                do idx = 1, np
+                    pt = plot_point()
+                    pt%rocket = .true.
+                    call plot_fill_eq(pt, prob, solutions(i, j, kth)%eq_soln(idx), &
+                                      solutions(i, j, kth)%eq_partials(idx), solver%eq_solver%products%species_names)
+                    pt%son = solutions(i, j, kth)%v_sonic(idx)
+                    call plot_fill_ratios(pt, prob, solver%eq_solver%reactants, j)
+                    if (keq > 0) then
